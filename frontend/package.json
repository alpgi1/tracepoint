{
  "name": "tracepoint-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/sync-map-data.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/sync-map-data.mjs",
    "build": "next build",
    "start": "next start -p 3400",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "audit:pages": "node tools/audit/page-audit.mjs http://localhost:3400",
    "shots": "node tools/audit/screenshots.mjs http://localhost:3400"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "2.1.1",
    "d3-geo": "3.1.1",
    "lucide-react": "^1.55.0",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "3.5.0",
    "topojson-client": "3.1.0",
    "tw-animate-css": "^1.4.0",
    "world-atlas": "2.0.2"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/d3-geo": "3.1.0",
    "@types/geojson": "7946.0.16",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/topojson-client": "3.1.5",
    "@types/topojson-specification": "^1.0.5",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "shadcn": "^4.21.4",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^3.2.7"
  },
  "packageManager": "pnpm@10.28.0",
