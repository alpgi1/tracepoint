{
  "name": "tracepoint-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/sync-map-data.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/sync-map-data.mjs",
    "build": "next build",
    "start": "next start -p 3400",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "audit:pages": "node tools/audit/page-audit.mjs http://localhost:3400 / /markets/eu/f70 /markets/eu/g60 /markets/eu/g70 /markets/us/g60 /markets/us/g70 /markets/cn/g68 /markets/cn/g70 /markets/us/g60/structure \"/markets/us/g60/structure?view=all\" \"/markets/us/g60/structure?view=excluded\" \"/markets/eu/f70/structure?view=all&subsystem=software_hmi\" /markets/cn/g68/structure /markets/us/g60/requirements /markets/us/g60/requirements/req-g60-us-ic-01 /markets/us/g60/requirements/req-g60-us-pr-03 /markets/eu/f70/requirements/req-f70-eu-id-01 /markets/cn/g68/requirements",
    "shots": "node tools/audit/screenshots.mjs http://localhost:3400",
    "vehicles": "node scripts/vehicles/build.mjs",
    "content": "python3 scripts/build-content.py && python3 scripts/build-cpm.py",
    "snapshot": "node scripts/snapshot-workspace.mjs",
    "photos": "node scripts/vehicles/photos.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "2.1.1",
    "d3-geo": "3.1.1",
    "lucide-react": "^1.55.0",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "3.5.0",
    "topojson-client": "3.1.0",
    "tw-animate-css": "^1.4.0",
    "world-atlas": "2.0.2"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/d3-geo": "3.1.0",
    "@types/geojson": "7946.0.16",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/topojson-client": "3.1.5",
    "@types/topojson-specification": "^1.0.5",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "shadcn": "^4.21.4",
    "sharp": "0.35.5",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^3.2.7"
  },
  "packageManager": "pnpm@10.28.0",
  "description": "Tracepoint web UI. Landing page with the dotted market map; PM workspace from Phase 6."
}
