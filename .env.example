# Copy to .env (repository root) and adjust. All variables are optional.
TRACEPOINT_DATABASE_URL=postgresql+psycopg://tracepoint:tracepoint@localhost:5432/tracepoint
TRACEPOINT_TEST_DATABASE_URL=postgresql+psycopg://tracepoint:tracepoint@localhost:5432/tracepoint_test
# LLM / embedding provider (values to be provided by the team in a later step)
TRACEPOINT_LLM_PROVIDER=openai
TRACEPOINT_OPENAI_API_KEY=
TRACEPOINT_OPENAI_MODEL=
TRACEPOINT_EMBEDDING_MODEL=
