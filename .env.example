# Copy to .env (repository root) and adjust. All variables are optional.
TRACEPOINT_DATABASE_URL=postgresql+psycopg://tracepoint:tracepoint@localhost:5432/tracepoint
TRACEPOINT_TEST_DATABASE_URL=postgresql+psycopg://tracepoint:tracepoint@localhost:5432/tracepoint_test
# LLM / embedding provider. Only the API key is secret; leave BASE_URL empty for api.openai.com.
TRACEPOINT_LLM_PROVIDER=openai
TRACEPOINT_OPENAI_API_KEY=
TRACEPOINT_OPENAI_MODEL=gpt-5.4
TRACEPOINT_OPENAI_MODEL_BULK=gpt-5.4-mini
TRACEPOINT_OPENAI_BASE_URL=
TRACEPOINT_LLM_MAX_COST_USD_PER_RUN=25
# All runs of the last 24 hours together (0 = no limit)
TRACEPOINT_LLM_MAX_COST_USD_PER_DAY=50
TRACEPOINT_LLM_CONCURRENCY=4
TRACEPOINT_EMBEDDING_MODEL=text-embedding-3-small
